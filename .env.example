# Jev (TypeSafe System One). Same variables the claude-jev plugin reads.
# TYPESAFE_API_KEY is read first. A key starting with sk-or- calls OpenRouter instead.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# JEV_MODEL=jev-latest
# JEV_BASE_URL=            # override the endpoint, e.g. http://127.0.0.1:8787/v1/systemone for the mock
# JEV_PRICE_PER_CALL_USD=  # override the per-call price used by the live cost meter

# Planner and uncertain-band review.
# auto = ANTHROPIC_API_KEY if set, else the local `claude` CLI (your subscription login), else Ollama, else a template plan.
# PLANNER=auto            # auto | anthropic | claude-cli | ollama | template
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=sonnet     # alias for the CLI, or a full model ID for the API
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gpt-oss:20b

# Where runs and uploads are stored.
# DATA_DIR=.data
# ALLOW_PRIVATE_URLS=0    # set to 1 to allow localhost / LAN URLs as sources
